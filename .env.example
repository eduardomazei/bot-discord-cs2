DISCORD_TOKEN=token_do_discord_developer
CLIENT_ID=id_da_aplicacao_discord
GUILD_ID=id_discord_guild
SPREADSHEET_ID=id_planilha
GOOGLE_SERVICE_ACCOUNT_EMAIL=email_servico_google
GOOGLE_PRIVATE_KEY=sua_chave_privada_aqui

# Canais usados pelos comandos migrados do trupe-bot (opcionais, mas /lives e /anuncio
# avisam se não estiverem configurados). Ver comando /config para o painel de status.
CANAL_LIVES_ID=id_do_canal_de_lives
CANAL_LOGS_ID=id_do_canal_de_logs
CANAL_ANUNCIOS_ID=id_do_canal_de_anuncios

# PTERODACTYL_API_KEY/PTERODACTYL_URL/SERVER_ID_1..4 saíram daqui em 16/09/2026 -- eram só
# pro /importar-partida do bot (integração com o painel Pterodactyl/MatchZy), descontinuado
# nessa data (site já é Supabase-only e mais capaz, ver /admin/importar-partida no trupe-site).

# Dual-write pro Supabase (plano de migração Sheets -> Supabase) -- mesmo projeto do trupe-site.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role

# Base do site -- usada pelos comandos de stats que só apontam pro site (utils/siteLinks.js).
# Opcional: cai pro domínio de produção se não estiver definida.
SITE_URL=https://trupemix.com.br

# Cookie de uma sessão logada do YouTube (formato "nome1=valor1; nome2=valor2; ..."), usado
# pelo yt-dlp em /tocar. Na prática não resolveu sozinho o bloqueio anti-bot do YouTube em IP de
# datacenter (SquareCloud) -- ver YOUTUBE_PROXY abaixo, que foi o que resolveu de fato. Mantido
# como opcional/fallback. Use uma conta Google secundária, não a principal -- é uma automação
# acessando com esse cookie.
YOUTUBE_COOKIE=

# Proxy residencial/móvel (formato "http://usuario:senha@host:porta" ou "socks5://..."), usado
# pelo yt-dlp em /tocar pra sair da rede por um IP não-datacenter. O YouTube bloqueia buscas e
# streams vindos do IP do SquareCloud ("Sign in to confirm you're not a bot") mesmo com cookie e
# client spoofing (tv/android) -- só um IP residencial de verdade contorna isso. Provedores
# pay-as-you-go tipo DataImpulse/Evomi/GeoNode custam na faixa de US$1/GB, barato pro volume de
# um bot de música de servidor privado.
YOUTUBE_PROXY=